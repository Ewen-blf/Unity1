<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="hotbar-container" style="flex-grow: 1; position: absolute; bottom: 20px; left: 0; right: 0; flex-direction: row; justify-content: center;"/>
    <ui:VisualElement name="workbench-container" style="flex-grow: 1; bottom: 0; align-items: center; justify-content: center; display: none; -unity-background-scale-mode: stretch-to-fill; -unity-slice-type: sliced; background-color: rgba(58, 112, 187, 0); position: absolute; right: 0; left: 0; top: 0;">
        <ui:VisualElement name="blur-bg" style="flex-grow: 1; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(0, 0, 0, 0.08); filter: blur(50);"/>
        <ui:VisualElement name="craft-panel" style="flex-grow: 1; background-color: rgba(55, 55, 55, 0); padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
            <ui:VisualElement name="slots-row" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="slot-1" style="flex-grow: 1; top: 60px; width: 64px; height: 64px; background-color: rgb(140, 140, 140);"/>
                <ui:VisualElement name="slot-2" style="flex-grow: 1; top: 60px; width: 64px; height: 64px; background-color: rgb(128, 128, 128);"/>
                <ui:VisualElement name="slot-3" style="flex-grow: 1; top: 60px; width: 64px; height: 64px; background-color: rgb(140, 140, 140);"/>
            </ui:VisualElement>
            <ui:Button text="Fabriquer" name="craft-button" style="-unity-text-align: middle-center; height: 61px; width: 152px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
